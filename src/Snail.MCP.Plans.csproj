<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RollForward>LatestMajor</RollForward>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <!--
        A native program wherever it is published for a runtime, and a native dotnet tool package for each platform
        with a framework-dependent one for the rest (docs/publishing.md in Snail.MCP.CleanUp): `dotnet pack` makes the
        package that points at them, `dotnet pack -r <rid>` each native one on its own system,
        `dotnet pack -r any -p:PublishAot=false` the fallback. Plans are files in SQLite only, so Windows is among them.
    -->
    <PropertyGroup>
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Size</OptimizationPreference>
        <ToolPackageRuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;linux-arm64;win-x64;any</ToolPackageRuntimeIdentifiers>
        <IsAotCompatible>true</IsAotCompatible>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <InvariantGlobalization>true</InvariantGlobalization>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <PublishDocumentationFile>false</PublishDocumentationFile>
        <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
        <SnailMcpName>Snail.MCP.Plans</SnailMcpName>
    </PropertyGroup>

    <PropertyGroup>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>snail-mcp-plans</ToolCommandName>
        <PackageType>McpServer</PackageType>
        <PackageId>Snail.MCP.Plans</PackageId>
        <PackageVersion>0.1.0</PackageVersion>
        <Authors>orldev</Authors>
        <Description>MCP server that holds an agent's plan: the agent drafts steps before starting, walks them in order, marks each done or failed and revises the plan as work goes, while another session asks which plans are active and how far along they are.</Description>
        <PackageTags>mcp;mcp-server;modelcontextprotocol;ai;agent;planning;todo;sqlite</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/orldev/Snail.MCP.Plans</PackageProjectUrl>
        <RepositoryUrl>https://github.com/orldev/Snail.MCP.Plans</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="/" Visible="false"/>
        <None Include="..\.mcp\server.json" Pack="true" PackagePath="/.mcp/" Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11"/>
        <PackageReference Include="Snail.Toolkit.Mcp.Hosting" Version="0.1.0-preview.1"/>
        <PackageReference Include="Snail.Toolkit.Mcp.Build" Version="0.1.0-preview.1" PrivateAssets="all"/>
        <PackageReference Include="ModelContextProtocol" Version="2.2.0"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.MCP.Plans.Tests"/>
    </ItemGroup>

</Project>
