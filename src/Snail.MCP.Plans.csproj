<Project Sdk="Snail.Sdk.Mcp">

    <!--
        A native stdio server (Snail.Sdk.Mcp: SnailMcpNative and SnailMcpTransport at their defaults): published with
        Native AOT, settings bound by generated code, a native dotnet tool package for each platform with a
        framework-dependent one for the rest. Plans are files in SQLite only, so Windows is among them.
    -->
    <PropertyGroup>
        <Version>0.1.0</Version>
        <Description>MCP server that holds an agent's plan: the agent drafts steps before starting, walks them in order, marks each done or failed and revises the plan as work goes, while another session asks which plans are active and how far along they are.</Description>
        <PackageTags>mcp;mcp-server;modelcontextprotocol;ai;agent;planning;todo;sqlite</PackageTags>
        <PackageProjectUrl>https://github.com/orldev/Snail.MCP.Plans</PackageProjectUrl>
        <RepositoryUrl>https://github.com/orldev/Snail.MCP.Plans</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite"/>
        <PackageReference Include="ModelContextProtocol"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.MCP.Plans.Tests"/>
    </ItemGroup>

</Project>
